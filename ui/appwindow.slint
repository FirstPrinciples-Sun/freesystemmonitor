import { Button, LineEdit, CheckBox, ComboBox, ListView, ScrollView } from "std-widgets.slint";

struct ProcRow {
    name: string,
    pid: int,
    cpu: float,
    mem: float,
    mem_mb: float,
    user: string,
    status: string,
    disk_str: string,
    icon: image,
}

struct CoreRow {
    label: string,
    usage: float,
}

struct ServiceRow {
    name: string,
    desc: string,
    state: string,
    active: bool,
}

struct AutostartRow {
    name: string,
    file: string,
    enabled: bool,
}

struct AppRow {
    name: string,
    id: string,
    size: string,
    origin: string,
    pct: float,
}

struct SizeRow {
    label: string,
    info: string,
    pct: float,
}

struct MountRow {
    mp: string,
    info: string,
    pct: float,
}

// ---- gradient usage bar ----
component GBar inherits Rectangle {
    in property <float> pct;
    in property <color> a1;
    in property <color> a2;
    height: 9px;
    background: #ffffff12;
    border-radius: 5px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * min(max(pct, 0) / 100, 1);
        height: parent.height;
        background: @linear-gradient(90deg, a1, a2);
        border-radius: 5px;
        drop-shadow-blur: 6px;
        drop-shadow-color: a1;
    }
}

// ---- 60-point history graph (bottom-anchored bars) ----
component HistGraph inherits Rectangle {
    in property <[float]> data;
    in property <color> a1;
    in property <color> a2;
    in property <float> bw: 4;
    in property <float> gap: 2;
    in property <float> gh: 80;
    height: gh * 1px;
    HorizontalLayout {
        spacing: gap * 1px;
        for h in data: Rectangle {
            width: bw * 1px;
            height: gh * 1px;
            Rectangle {
                width: parent.width;
                height: max(2px, (gh - 6) * 1px * h / 100);
                y: parent.height - self.height;
                background: @linear-gradient(0deg, a1, a2);
                border-radius: 1px;
                opacity: 0.85;
            }
        }
    }
}

// ---- area chart: filled time series (path strings built in Rust; binding-safe) ----
component AreaChart inherits Rectangle {
    in property <string> area;
    in property <string> line;
    in property <color> a1;
    in property <color> fillc;
    in property <float> lasty;
    in property <float> hh: 90;
    // fixed 300px block: deterministic in any card, centered by the layout
    width: 300px;
    height: hh * 1px;
    clip: true;
    // gridlines
    Rectangle { y: (hh * 0.75) * 1px; height: 1px; width: 300px; background: #ffffff0e; }
    Rectangle { y: (hh * 0.5) * 1px; height: 1px; width: 300px; background: #ffffff0e; }
    Rectangle { y: (hh * 0.25) * 1px; height: 1px; width: 300px; background: #ffffff0e; }
    Path {
        width: 300px;
        height: hh * 1px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 300;
        viewbox-height: hh;
        commands: area;
        fill: fillc;
    }
    Path {
        width: 300px;
        height: hh * 1px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 300;
        viewbox-height: hh;
        commands: line;
        fill: #00000000;
        stroke: a1;
        stroke-width: 2px;
    }
    Rectangle {
        width: 7px;
        height: 7px;
        border-radius: 4px;
        x: 292px;
        y: lasty * 1px - 3px;
        background: @linear-gradient(135deg, a1, #ffffff);
        drop-shadow-blur: 8px;
        drop-shadow-color: a1;
    }
}

// ---- donut gauge: pie wedge + solid hub + center label ----
component Donut inherits Rectangle {
    in property <float> pct;
    in property <color> a1;
    in property <string> caption;
    width: 118px;
    height: 118px;
    Path {
        width: 100px;
        height: 100px;
        x: 9px;
        y: 9px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        MoveTo { x: 50; y: 8; }
        ArcTo { radius-x: 42; radius-y: 42; x-rotation: 0; large-arc: true; sweep: true; x: 50; y: 92; }
        ArcTo { radius-x: 42; radius-y: 42; x-rotation: 0; large-arc: true; sweep: true; x: 50; y: 8; }
        fill: #ffffff12;
    }
    if pct > 0.5 && pct < 99.5 : Path {
        width: 100px;
        height: 100px;
        x: 9px;
        y: 9px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        MoveTo { x: 50; y: 50; }
        LineTo { x: 50; y: 8; }
        ArcTo { radius-x: 42; radius-y: 42; x-rotation: 0; large-arc: pct > 50; sweep: true; x: 50 + 42 * Math.cos((pct * 3.6 - 90) * 1deg); y: 50 + 42 * Math.sin((pct * 3.6 - 90) * 1deg); }
        Close { }
        fill: a1;
    }
    if pct >= 99.5 : Path {
        width: 100px;
        height: 100px;
        x: 9px;
        y: 9px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        MoveTo { x: 50; y: 8; }
        ArcTo { radius-x: 42; radius-y: 42; x-rotation: 0; large-arc: true; sweep: true; x: 50; y: 92; }
        ArcTo { radius-x: 42; radius-y: 42; x-rotation: 0; large-arc: true; sweep: true; x: 50; y: 8; }
        fill: a1;
    }
    Rectangle {
        x: 30px;
        y: 30px;
        width: 58px;
        height: 58px;
        border-radius: 29px;
        background: #161b28;
    }
    Text {
        text: caption;
        color: #ffffff;
        font-size: 17px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 118px;
        height: 118px;
    }
}

// ---- sidebar nav pill ----
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> a1;
    in property <color> a2;
    callback tapped();
    height: 38px;
    border-radius: 11px;
    background: active ? @linear-gradient(90deg, a1, a2) : #ffffff00;
    drop-shadow-blur: active ? 18px : 0px;
    drop-shadow-color: a2;
    HorizontalLayout {
        padding-left: 14px;
        Text {
            text: label;
            color: #ffffff;
            font-size: 14px;
            font-weight: active ? 700 : 400;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { tapped(); }
    }
}

// ---- accent swatch ----
component Swatch inherits Rectangle {
    in property <color> c1;
    in property <color> c2;
    in property <bool> selected;
    callback picked();
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background: @linear-gradient(135deg, c1, c2);
    border-width: selected ? 3px : 0px;
    border-color: #ffffff;
    TouchArea {
        clicked => { picked(); }
    }
}

// ---- glass card ----
component Card inherits Rectangle {
    background: #ffffff09;
    border-width: 1px;
    border-color: #ffffff26;
    border-radius: 16px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000055;
    VerticalLayout {
        alignment: start;
        padding: 14px;
        spacing: 8px;
        @children
    }
}

component CardTitle inherits Text {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    overflow: elide;
}

component Dim inherits Text {
    color: #9aa0a6;
    font-size: 13px;
    overflow: elide;
}

component Body inherits Text {
    color: #dfe3ea;
    font-size: 13px;
    overflow: elide;
}

// big dashboard number with soft neon echo behind the glyphs
component GlowNum inherits Rectangle {
    in property <string> label;
    in property <color> glow;
    height: 28px;
    Text {
        text: label;
        color: glow;
        x: 1px;
        y: 1px;
        font-size: 20px;
        font-weight: 700;
        opacity: 0.55;
        overflow: elide;
        width: parent.width;
    }
    Text {
        text: label;
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
        overflow: elide;
        width: parent.width;
    }
}

export component AppWindow inherits Window {
    title: "FreeMon — System Monitor for KDE";
    preferred-width: 1160px;
    preferred-height: 720px;
    min-width: 940px;
    min-height: 580px;
    background: @linear-gradient(150deg, #272e40 0%, #14171f 48%, #1b2133 100%);

    // ---- navigation ----
    in-out property <int> current-page: 0;
    // ---- theme (customizable) ----
    in-out property <color> accent1: #3daee9;
    in-out property <color> accent2: #7b61ff;
    in-out property <string> accent-name: "breeze";
    in-out property <int> refresh-secs: 1;
    // ---- system snapshot (updated from Rust) ----
    in-out property <float> cpu-usage: 0;
    in-out property <string> cpu-brand: "—";
    in-out property <int> cpu-count: 1;
    in-out property <float> mem-used-gb: 0;
    in-out property <float> mem-total-gb: 1;
    in-out property <float> mem-pct: 0;
    in-out property <float> swap-used-gb: 0;
    in-out property <float> swap-total-gb: 1;
    in-out property <float> swap-pct: 0;
    in-out property <string> load-avg: "—";
    in-out property <string> uptime: "—";
    in-out property <string> hostname: "—";
    in-out property <string> kernel: "—";
    in-out property <string> distro: "—";
    in-out property <string> desktop: "—";
    in-out property <string> gpu-name: "—";
    in-out property <string> cpu-temp: "—";
    in-out property <string> net-stat: "—";
    in-out property <string> disk-stat: "—";
    in-out property <string> battery: "—";
    in-out property <string> clock: "—";
    in-out property <string> status-msg: "Ready";
    in-out property <int> proc-count: 0;

    in-out property <[ProcRow]> processes;
    in-out property <[CoreRow]> cores;
    in-out property <[ServiceRow]> services;
    in-out property <[AutostartRow]> autostart;
    in-out property <[AppRow]> apps;
    in-out property <[float]> cpu-hist;
    in-out property <[float]> mem-hist;
    in-out property <[float]> swap-hist;
    in-out property <[float]> netdown-hist;
    in-out property <[float]> netup-hist;
    in-out property <string> cpu-area: "";
    in-out property <string> cpu-line: "";
    in-out property <float> cpu-ly: 84;
    in-out property <string> mem-area: "";
    in-out property <string> mem-line: "";
    in-out property <float> mem-ly: 84;
    in-out property <string> swap-area: "";
    in-out property <string> swap-line: "";
    in-out property <float> swap-ly: 84;
    in-out property <string> net-rate: "—";
    in-out property <float> disk-pct: 0;
    in-out property <string> cpu-freq: "—";
    in-out property <float> mem-free: 0;
    in-out property <float> gpu-use: -1;
    in-out property <string> gpu-sub: "usage unavailable on this GPU";
    in-out property <float> intel-use: -1;
    in-out property <string> intel-sub: "integrated · no driver data";
    in-out property <bool> alert-on: false;
    in-out property <string> alert-text: "";
    in-out property <float> batt-pct: -1;
    in-out property <bool> batt-charging: false;
    in-out property <color> area-fill: #3daee92e;
    in-out property <[MountRow]> mounts;
    in-out property <[SizeRow]> size-rows;
    in-out property <int> log-err: 0;
    in-out property <int> log-warn: 0;
    in-out property <int> log-tot: 0;
    in-out property <int> svc-act: 0;
    in-out property <int> svc-tot: 0;
    in-out property <int> auto-act: 0;
    in-out property <int> auto-tot: 0;
    in-out property <int> app-tot: 0;
    in-out property <string> logs-text: "";
    in-out property <string> cleaner-info: "";
    in-out property <string> search-text: "";
    in-out property <int> sort-idx: 0;
    in-out property <string> sort-name: "CPU";
    in-out property <int> sel-pid: 0;
    in-out property <string> sel-name: "";
    in-out property <int> sel-nice: 0;

    callback kill-process(int);
    callback stop-process(int);
    callback renice-process(int, int);
    callback search-changed(string);
    callback set-sort(string);
    callback select-process(int, string);
    callback nice-delta(int);
    callback service-action(string, string);
    callback refresh-services();
    callback toggle-autostart(string, bool);
    callback clean-kind(string);
    callback refresh-logs();
    callback uninstall-app(string);
    callback set-accent(string);
    callback set-interval(int);

    HorizontalLayout {
        spacing: 0px;

        // ===== Sidebar (frosted) =====
        Rectangle {
            width: 212px;
            background: #00000038;
            border-width: 1px;
            border-color: #ffffff12;
            VerticalLayout {
                padding: 14px;
                spacing: 5px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: @linear-gradient(135deg, accent1, accent2);
                        drop-shadow-blur: 14px;
                        drop-shadow-color: accent2;
                        Text {
                            text: "❄";
                            color: #ffffff;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        Text { text: "FreeMon"; color: #ffffff; font-size: 18px; font-weight: 800; }
                        Dim { text: "for KDE Plasma"; }
                    }
                }
                Rectangle { height: 6px; }
                Dim { text: clock; }
                Rectangle { height: 6px; }
                NavItem { label: "◉  Overview"; active: current-page == 0; a1: accent1; a2: accent2; tapped => { current-page = 0; } }
                NavItem { label: "☰  Processes"; active: current-page == 1; a1: accent1; a2: accent2; tapped => { current-page = 1; } }
                NavItem { label: "📈  Performance"; active: current-page == 2; a1: accent1; a2: accent2; tapped => { current-page = 2; } }
                NavItem { label: "⚙  Services"; active: current-page == 3; a1: accent1; a2: accent2; tapped => { current-page = 3; } }
                NavItem { label: "🚀  Startup"; active: current-page == 4; a1: accent1; a2: accent2; tapped => { current-page = 4; } }
                NavItem { label: "📦  Apps"; active: current-page == 5; a1: accent1; a2: accent2; tapped => { current-page = 5; } }
                NavItem { label: "🧹  Cleaner"; active: current-page == 6; a1: accent1; a2: accent2; tapped => { current-page = 6; } }
                NavItem { label: "📜  Logs"; active: current-page == 7; a1: accent1; a2: accent2; tapped => { current-page = 7; } }
                NavItem { label: "ℹ  About"; active: current-page == 8; a1: accent1; a2: accent2; tapped => { current-page = 8; } }
                NavItem { label: "🎨  Theme"; active: current-page == 9; a1: accent1; a2: accent2; tapped => { current-page = 9; } }
                Rectangle { vertical-stretch: 1; }
                // status pill
                Rectangle {
                    height: 34px;
                    border-radius: 10px;
                    background: #ffffff0d;
                    border-width: 1px;
                    border-color: #ffffff14;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px;
                            background: @linear-gradient(135deg, accent1, accent2);
                            drop-shadow-blur: 6px;
                            drop-shadow-color: accent1;
                        }
                        Text {
                            text: "CPU " + round(cpu-usage) + "% · " + proc-count + " procs";
                            color: #cfd4dc;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ===== Main (scrolls vertically on short windows) =====
        ScrollView {
            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // ---- PAGE 0 : OVERVIEW ----
                if current-page == 0 : VerticalLayout {
                    alignment: start;
                    spacing: 12px;
                    Text { text: "Overview"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    if alert-on : Rectangle {
                        background: #da445322;
                        border-width: 1px;
                        border-color: #da445366;
                        border-radius: 12px;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text { text: alert-text; color: #ffd9d9; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: center;
                                Donut { pct: cpu-usage; a1: accent1; caption: round(cpu-usage) + "%"; }
                            }
                            CardTitle { text: "CPU"; horizontal-alignment: center; }
                            Dim { text: cpu-brand; horizontal-alignment: center; }
                            Dim { text: cpu-count + " threads · " + cpu-freq + " · " + cpu-temp; horizontal-alignment: center; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: center;
                                Donut { pct: mem-pct; a1: accent1; caption: round(mem-pct) + "%"; }
                            }
                            CardTitle { text: "Memory"; horizontal-alignment: center; }
                            Dim { text: mem-used-gb + " / " + mem-total-gb + " GB"; horizontal-alignment: center; }
                            Dim { text: "free " + mem-free + " GB · load " + load-avg; horizontal-alignment: center; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: center;
                                Donut { pct: disk-pct; a1: accent1; caption: round(disk-pct) + "%"; }
                            }
                            CardTitle { text: "Disk"; horizontal-alignment: center; }
                            Dim { text: disk-stat; horizontal-alignment: center; }
                            Dim { text: "up " + uptime; horizontal-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: center;
                                Donut { pct: gpu-use; a1: accent2; caption: gpu-use >= 0 ? round(gpu-use) + "%" : "—"; }
                            }
                            CardTitle { text: "NVIDIA GPU"; horizontal-alignment: center; }
                            Dim { text: gpu-name; horizontal-alignment: center; }
                            Dim { text: gpu-sub; horizontal-alignment: center; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: center;
                                Donut { pct: intel-use; a1: accent1; caption: intel-use >= 0 ? round(intel-use) + "%" : "—"; }
                            }
                            CardTitle { text: "Intel iGPU"; horizontal-alignment: center; }
                            Dim { text: "Raptor Lake-P UHD Graphics"; horizontal-alignment: center; }
                            Dim { text: intel-sub; horizontal-alignment: center; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            if batt-pct >= 0 : HorizontalLayout {
                                alignment: center;
                                Donut { pct: batt-pct; a1: accent1; caption: round(batt-pct) + "%"; }
                            }
                            CardTitle { text: "Battery"; horizontal-alignment: center; }
                            Dim { text: batt-pct >= 0 ? ("🔋  " + battery + (batt-charging ? " · charging" : "")) : "🔋  AC power · no battery"; horizontal-alignment: center; }
                            Dim { text: "🌡  " + cpu-temp; horizontal-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "CPU history · 60s"; }
                            AreaChart { area: cpu-area; line: cpu-line; lasty: cpu-ly; a1: accent1; fillc: area-fill; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "Memory history · 60s"; }
                            AreaChart { area: mem-area; line: mem-line; lasty: mem-ly; a1: accent1; fillc: area-fill; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "Swap history · 60s — " + swap-used-gb + " / " + swap-total-gb + " GB"; }
                            AreaChart { area: swap-area; line: swap-line; lasty: swap-ly; a1: accent1; fillc: area-fill; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "Network · " + net-rate; }
                            Dim { text: "▼ download (scale 10 MB/s)"; }
                            HistGraph { data: netdown-hist; a1: accent1; a2: accent2; bw: 2; gap: 1; gh: 40; }
                            Dim { text: "▲ upload"; }
                            HistGraph { data: netup-hist; a1: accent2; a2: #ffffff; bw: 2; gap: 1; gh: 40; }
                            Dim { text: net-stat; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "Thermals & Uptime"; }
                            GlowNum { label: "🌡  " + cpu-temp; glow: accent2; }
                            Dim { text: "up " + uptime + "  ·  load " + load-avg; }
                            Dim { text: "🔋  " + battery; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "Storage"; }
                            VerticalLayout {
                                spacing: 6px;
                                for m in mounts: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: m.mp; width: 110px; overflow: elide; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                    GBar { pct: m.pct; a1: accent1; a2: accent2; horizontal-stretch: 1; }
                                    Text { text: round(m.pct) + "%"; width: 44px; color: #9aa0a6; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                            Dim { text: disk-stat + " total on biggest volume"; }
                        }
                        Card {
                            horizontal-stretch: 1;
                            CardTitle { text: "System"; }
                            Body { text: "🖥  " + hostname; }
                            Body { text: "🐧  " + kernel; }
                            Dim { text: distro + " · " + desktop; }
                        }
                    }
                }

                // ---- PAGE 1 : PROCESSES ----
                if current-page == 1 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "Processes (" + proc-count + ")"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Dim { text: "Top 100 · sorted by " + sort-name + " · Stop is SIGTERM, Kill is SIGKILL · click an icon to inspect"; }
                    Card {
                        HorizontalLayout {
                            spacing: 8px;
                            search := LineEdit {
                                placeholder-text: "Search process or PID…";
                                text <=> search-text;
                                edited => { search-changed(self.text); }
                                horizontal-stretch: 1;
                            }
                            ComboBox {
                                model: ["CPU", "Memory", "Disk", "Name", "PID"];
                                current-index <=> sort-idx;
                                selected(value) => { set-sort(value); }
                                width: 110px;
                            }
                            Button { text: "Clear"; clicked => { search.text = ""; search-changed(""); } }
                        }
                        HistGraph { data: cpu-hist; a1: accent1; a2: accent2; bw: 3; gap: 1; gh: 34; }
                    }
                    Card {
                        Dim { text: "PID        NAME                         CPU          MEM           DISK           USER"; }
                        Rectangle { height: 1px; background: #ffffff14; }
                        ListView {
                            height: 420px;
                            for p[i] in processes: Rectangle {
                                height: 36px;
                                background: p.pid == sel-pid ? #ffffff14 : (Math.mod(i, 2) == 0 ? #ffffff07 : #ffffff00);
                                border-radius: 8px;
                                TouchArea { x: 62px; width: 22px; height: 36px; clicked => { select-process(p.pid, p.name); } }
                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    Text { text: p.pid; width: 48px; color: #dfe3ea; font-size: 13px; vertical-alignment: center; }
                                    Image { source: p.icon; width: 22px; height: 22px; }
                                    Text { text: p.name; width: 148px; overflow: elide; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                    Text { text: round(p.cpu * 10) / 10 + "%"; width: 56px; color: #dfe3ea; font-size: 13px; vertical-alignment: center; }
                                    Text { text: p.mem_mb + " MB"; width: 72px; color: #dfe3ea; font-size: 13px; vertical-alignment: center; }
                                    Text { text: p.disk_str; width: 72px; color: #dfe3ea; font-size: 13px; vertical-alignment: center; }
                                    Text { text: p.user; width: 60px; overflow: elide; color: #9aa0a6; font-size: 13px; vertical-alignment: center; }
                                    Button { text: "Stop"; clicked => { stop-process(p.pid); } }
                                    Button { text: "Kill"; clicked => { kill-process(p.pid); } }
                                }
                            }
                        }
                    }
                    Card {
                        HorizontalLayout {
                            spacing: 8px;
                            if sel-pid > 0 : Text { text: "● " + sel-name + " (" + sel-pid + ") · nice " + sel-nice; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            if sel-pid <= 0 : Text { text: "○ click an app icon above to inspect and change priority"; color: #9aa0a6; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Priority −"; enabled: sel-pid > 0; clicked => { nice-delta(-1); } }
                            Button { text: "Priority +"; enabled: sel-pid > 0; clicked => { nice-delta(1); } }
                        }
                    }
                }

                // ---- PAGE 2 : PERFORMANCE ----
                if current-page == 2 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "Performance"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Dim { text: "Live per-thread load · follows refresh interval"; }
                    Card {
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Dim { text: "CPU · " + round(cpu-usage) + "%"; }
                                HistGraph { data: cpu-hist; a1: accent1; a2: accent2; bw: 2; gap: 1; gh: 40; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Dim { text: "Memory · " + round(mem-pct) + "%"; }
                                HistGraph { data: mem-hist; a1: accent1; a2: accent2; bw: 2; gap: 1; gh: 40; }
                            }
                        }
                    }
                    Card {
                        CardTitle { text: "Per-core CPU · live"; }
                        ScrollView {
                            height: 440px;
                            VerticalLayout {
                                spacing: 8px;
                                for c in cores: HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: c.label; width: 60px; color: #dfe3ea; font-size: 13px; vertical-alignment: center; }
                                    GBar { pct: c.usage; a1: accent1; a2: accent2; horizontal-stretch: 1; }
                                    Text { text: round(c.usage) + "%"; width: 50px; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // ---- PAGE 3 : SERVICES ----
                if current-page == 3 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Services"; color: #ffffff; font-size: 24px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "↻ Refresh"; clicked => { refresh-services(); } }
                    }
                    Dim { text: "User session services · systemctl --user start / stop / restart"; }
                    Dim { text: "No services found — is systemd running?"; visible: svc-tot == 0; }
                    Card {
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "● " + svc-act + " active / " + svc-tot + " total"; color: #ffffff; font-size: 13px; font-weight: 700; width: 190px; vertical-alignment: center; }
                            GBar { pct: svc-tot > 0 ? svc-act * 100 / svc-tot : 0; a1: accent1; a2: accent2; horizontal-stretch: 1; }
                        }
                        ListView {
                            height: 400px;
                            for s[i] in services: Rectangle {
                                height: 36px;
                                background: Math.mod(i, 2) == 0 ? #ffffff07 : #ffffff00;
                                border-radius: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    Text { text: s.active ? "●" : "○"; color: s.active ? accent1 : #555c66; width: 24px; font-size: 14px; vertical-alignment: center; }
                                    Text { text: s.name; width: 260px; overflow: elide; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                    Text { text: s.state; width: 90px; color: #9aa0a6; font-size: 13px; vertical-alignment: center; }
                                    Button { text: s.active ? "Stop" : "Start"; clicked => { service-action(s.name, s.active ? "stop" : "start"); } }
                                    Button { text: "Restart"; clicked => { service-action(s.name, "restart"); } }
                                }
                            }
                        }
                    }
                }

                // ---- PAGE 4 : STARTUP ----
                if current-page == 4 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "Startup"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Dim { text: "Apps that launch at login · toggles only touch your own ~/.config/autostart"; }
                    Dim { text: "No autostart entries in ~/.config/autostart or /etc/xdg/autostart"; visible: auto-tot == 0; }
                    Card {
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "✓ " + auto-act + " enabled / " + auto-tot + " total"; color: #ffffff; font-size: 13px; font-weight: 700; width: 190px; vertical-alignment: center; }
                            GBar { pct: auto-tot > 0 ? auto-act * 100 / auto-tot : 0; a1: accent1; a2: accent2; horizontal-stretch: 1; }
                        }
                        ListView {
                            height: 420px;
                            for a[i] in autostart: Rectangle {
                                height: 34px;
                                background: Math.mod(i, 2) == 0 ? #ffffff07 : #ffffff00;
                                border-radius: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-left: 8px;
                                    CheckBox {
                                        checked: a.enabled;
                                        toggled => { toggle-autostart(a.file, self.checked); }
                                    }
                                    Text { text: a.name; width: 260px; overflow: elide; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                    Text { text: a.file; overflow: elide; color: #9aa0a6; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }

                // ---- PAGE 5 : APPS ----
                if current-page == 5 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "Applications (" + app-tot + ")"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Dim { text: "Flatpak applications · bar shows size relative to the largest"; }
                    Dim { text: "No Flatpak apps found — is Flatpak installed with apps?"; visible: app-tot == 0; }
                    Card {
                        ListView {
                            height: 440px;
                            for ap[i] in apps: Rectangle {
                                height: 36px;
                                background: Math.mod(i, 2) == 0 ? #ffffff07 : #ffffff00;
                                border-radius: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    Text { text: ap.name; width: 220px; overflow: elide; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                    GBar { pct: ap.pct; a1: accent1; a2: accent2; width: 110px; }
                                    Text { text: ap.size; width: 80px; color: #9aa0a6; font-size: 13px; vertical-alignment: center; }
                                    Text { text: ap.origin; width: 90px; color: #9aa0a6; font-size: 13px; vertical-alignment: center; }
                                    Button { text: "Uninstall"; clicked => { uninstall-app(ap.id); } }
                                }
                            }
                        }
                    }
                }

                // ---- PAGE 6 : CLEANER ----
                if current-page == 6 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "Cleaner"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Dim { text: "Only your own cache, trash and thumbnails · journal vacuum may ask for root"; }
                    Card {
                        CardTitle { text: "Reclaimable space"; }
                        VerticalLayout {
                            spacing: 8px;
                            for r in size-rows: HorizontalLayout {
                                spacing: 10px;
                                Text { text: r.label; width: 110px; color: #ffffff; font-size: 13px; vertical-alignment: center; }
                                GBar { pct: r.pct; a1: accent1; a2: accent2; horizontal-stretch: 1; }
                                Text { text: r.info; width: 80px; color: #9aa0a6; font-size: 13px; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Journal 200M"; clicked => { clean-kind("journal"); } }
                            Button { text: "Trash"; clicked => { clean-kind("trash"); } }
                            Button { text: "Thumbnails"; clicked => { clean-kind("thumbs"); } }
                            Button { text: "Safe cache"; clicked => { clean-kind("all"); } }
                        }
                    }
                }

                // ---- PAGE 7 : LOGS ----
                if current-page == 7 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Logs"; color: #ffffff; font-size: 24px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "↻ Refresh"; clicked => { refresh-logs(); } }
                    }
                    Dim { text: "Last 200 journal lines · errors and warnings counted locally"; }
                    Card {
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "⛔ " + log-err + " errors"; color: #ffffff; font-size: 13px; font-weight: 700; width: 130px; vertical-alignment: center; }
                            GBar { pct: log-tot > 0 ? log-err * 100 / log-tot : 0; a1: #da4453; a2: #f67400; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "⚠ " + log-warn + " warnings"; color: #ffffff; font-size: 13px; font-weight: 700; width: 130px; vertical-alignment: center; }
                            GBar { pct: log-tot > 0 ? log-warn * 100 / log-tot : 0; a1: #f7b500; a2: #f67400; horizontal-stretch: 1; }
                        }
                        Dim { text: "in last " + log-tot + " journal lines"; }
                        ScrollView {
                            height: 440px;
                            Text { text: logs-text; color: #cfd4dc; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }

                // ---- PAGE 8 : ABOUT ----
                if current-page == 8 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "About"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Card {
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 64px; height: 64px; border-radius: 18px;
                                background: @linear-gradient(135deg, accent1, accent2);
                                Text { text: "❄"; color: #ffffff; font-size: 32px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "FreeMon 0.1.0"; color: #ffffff; font-size: 20px; font-weight: 800; }
                                Dim { text: "Free System Monitor for KDE · Rust + Slint · GPL-3.0-or-later"; }
                            }
                        }
                    }
                    Card {
                        Body { text: "Host: " + hostname; }
                        Body { text: "Distro: " + distro; }
                        Body { text: "Kernel: " + kernel; }
                        Body { text: "Desktop: " + desktop + "  ·  Uptime " + uptime; }
                        Body { text: "CPU: " + cpu-brand + " × " + cpu-count; }
                        Body { text: "GPU: " + gpu-name; }
                    }
                }

                // ---- PAGE 9 : THEME ----
                if current-page == 9 : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text { text: "Theme"; color: #ffffff; font-size: 24px; font-weight: 800; }
                    Card {
                        CardTitle { text: "Accent gradient"; }
                        Dim { text: "Pick a vibe — sidebar, bars, graphs and status follow instantly."; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout { spacing: 4px; Swatch { c1: #3daee9; c2: #7b61ff; selected: accent-name == "breeze"; picked => { set-accent("breeze"); } } Dim { text: "Breeze"; horizontal-alignment: center; } }
                            VerticalLayout { spacing: 4px; Swatch { c1: #2ecc71; c2: #1abc9c; selected: accent-name == "mint"; picked => { set-accent("mint"); } } Dim { text: "Mint"; horizontal-alignment: center; } }
                            VerticalLayout { spacing: 4px; Swatch { c1: #f67400; c2: #da4453; selected: accent-name == "sunset"; picked => { set-accent("sunset"); } } Dim { text: "Sunset"; horizontal-alignment: center; } }
                            VerticalLayout { spacing: 4px; Swatch { c1: #9b59b6; c2: #e84393; selected: accent-name == "grape"; picked => { set-accent("grape"); } } Dim { text: "Grape"; horizontal-alignment: center; } }
                            VerticalLayout { spacing: 4px; Swatch { c1: #f7b500; c2: #f67400; selected: accent-name == "gold"; picked => { set-accent("gold"); } } Dim { text: "Gold"; horizontal-alignment: center; } }
                        }
                    }
                    Card {
                        CardTitle { text: "Live updates"; }
                        Dim { text: "How often graphs and numbers refresh. Saved automatically."; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "1s ⚡"; primary: refresh-secs == 1; clicked => { set-interval(1); } }
                            Button { text: "2s"; primary: refresh-secs == 2; clicked => { set-interval(2); } }
                            Button { text: "5s 🌙"; primary: refresh-secs == 5; clicked => { set-interval(5); } }
                        }
                    }
                    Card {
                        CardTitle { text: "Status"; }
                        Body { text: status-msg; }
                    }
                }
            }
        }
    }
}
